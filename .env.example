# NextGen Navigators - Environment Configuration

# -----------------------------------------------------------------------------
# SUPABASE BACKEND CONFIGURATION
# -----------------------------------------------------------------------------
# 1. Create a free project at https://supabase.com
# 2. Go to Project Settings -> API in your Supabase dashboard
# 3. Copy your "Project URL" into VITE_SUPABASE_URL
# 4. Copy your "Project API keys" -> "anon public" key into VITE_SUPABASE_ANON_KEY
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=YOUR_SUPABASE_URL
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Optional alias for publishable key
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# -----------------------------------------------------------------------------
# OTHER CONFIGURATIONS
# -----------------------------------------------------------------------------
# Google Gemini API Key (Server-Side Proxy; never exposed to browser)
GEMINI_API_KEY=

# Administrative Portal Setup
ADMIN_USERNAME=admin@nextgennavigators.in
ADMIN_DEFAULT_PASSWORD=NextGenAdmin2026!

# Server & Port
PORT=5173
